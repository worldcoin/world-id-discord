# Example environment for the World ID Discord integration (IDKit 4).
# Copy to .env.local and fill in the remaining values. Never commit real secrets.

# App environment
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=

# Discord (application id and public key come from the Discord Developer
# Portal; the bot token and app secret are secrets)
DISCORD_APP_ID=
DISCORD_APP_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_APP_SECRET=

# App URL
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Developer Portal (World ID 4)
NEXT_PUBLIC_APP_ID=app_
NEXT_PUBLIC_RP_ID=rp_
RP_SIGNING_KEY=
DEVELOPER_PORTAL_URL=https://developer.world.org
DEVELOPER_PORTAL_API_KEY=

# PostHog
POSTHOG_API_KEY=
POSTHOG_HOST=

# Discord integration API
DISCORD_INTEGRATION_API_URL=
DISCORD_INTEGRATION_API_SIGN_SECRET=
DISCORD_INTERACTION_TOKEN_SIGN_SECRET=
